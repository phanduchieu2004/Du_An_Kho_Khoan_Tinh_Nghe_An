<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    main { width: min(900px, calc(100% - 32px)); margin: 36px auto; padding: 26px; background: #fff; border: 1px solid #dce5e1; border-radius: 8px; }
    .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .wide { grid-column: 1 / -1; }
    textarea { min-height: 100px; }
    .help { color: #667772; font-size: 13px; }
    @media (max-width: 650px) { .fields { grid-template-columns: 1fr; } .wide { grid-column: auto; } main { padding: 18px; } }
  </style>
</head>
<body>
  <%- include('thanh-phan/dau_trang_cong') %>
  <main>
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
      <div><h1 class="h3 mb-1">Sửa dữ liệu · <%= label %></h1><p class="help mb-0">Mã: <%= id %></p></div>
      <a class="btn btn-outline-secondary" href="/">Đóng</a>
    </div>
    <form method="post" action="/records/<%= table %>/<%= id %>/edit">
      <div class="fields">
        <% fields.forEach((field) => { %>
          <% if (field.type === 'textarea') { %>
            <div class="wide">
              <label class="form-label" for="field-<%= field.name %>"><%= field.label %></label>
              <textarea class="form-control" id="field-<%= field.name %>" name="<%= field.name %>" <%= field.required ? 'required' : '' %>><%= field.value %></textarea>
              <% if (field.name === 'ranh_gioi') { %><p class="help mt-1">Có thể nhập kinh độ/vĩ độ WGS84 hoặc X/Y VN-2000 TM-3 kinh tuyến trục 104°45′ (mét); hệ thống chuyển cả phép chiếu và datum VN-2000 sang WGS84.</p><% } %>
            </div>
          <% } else if (field.type === 'checkbox') { %>
            <div class="form-check mt-4">
              <input class="form-check-input" type="checkbox" id="field-<%= field.name %>" name="<%= field.name %>" value="true" <%= field.value === 'true' ? 'checked' : '' %> />
              <label class="form-check-label" for="field-<%= field.name %>"><%= field.label %></label>
            </div>
          <% } else { %>
            <div>
              <label class="form-label" for="field-<%= field.name %>"><%= field.label %></label>
              <input class="form-control" type="<%= field.writeOnly ? 'password' : field.type %>" id="field-<%= field.name %>" name="<%= field.name %>" value="<%= field.value %>" <%= field.required ? 'required' : '' %><% if (field.name === 'cap_mat_bang') { %> min="1" step="1"<% } else if (field.type === 'number') { %> step="any"<% } %> autocomplete="<%= field.writeOnly ? 'new-password' : 'off' %>" />
              <% if (field.writeOnly) { %><p class="help mt-1">Để trống nếu không muốn đổi mật khẩu.</p><% } %>
            </div>
          <% } %>
        <% }) %>
      </div>
      <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-secondary" href="/">Hủy</a>
        <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
      </div>
    </form>
  </main>
</body>
</html>
