<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    main { max-width: 1440px; margin: 0 auto; padding: 28px 24px 48px; }
    .table-frame { overflow: auto; border: 1px solid #dce5e1; background: #fff; }
    table { margin: 0 !important; }
    thead th { background: #e9f0ed !important; color: #344b44; white-space: nowrap; }
    td { vertical-align: middle; }
    @media (max-width: 700px) { main { padding: 22px 12px 36px; } }
  </style>
</head>
<body>
  <%- include('thanh-phan/dau_trang_quan_tri') %>
  <main>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
      <h1 class="h3 mb-0"><%= title %></h1>
      <a class="btn btn-outline-secondary" href="/cong-trinh/danh-sach">Quản lý công trình</a>
    </div>
    <% if (renewalApproved) { %>
      <div class="alert alert-success" role="status">Đã duyệt gia hạn và cập nhật thời hạn công trình được phân công.</div>
    <% } %>
    <div class="table-frame">
      <table class="table table-hover table-striped table-bordered align-middle">
        <thead>
          <tr><th>Kỹ sư</th><th>Công trình</th><th>Khu vực</th><th>Hạn hiện tại</th><th>Hạn đề xuất</th><th>Lý do</th><th>Ngày gửi</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr><td colspan="8" class="text-center p-4 text-secondary">Không có yêu cầu gia hạn nào đang chờ duyệt.</td></tr>
          <% } else { %>
            <% requests.forEach((request) => { %>
              <tr>
                <td><%= request.ho_ten || request.ten_dang_nhap %></td>
                <td><%= request.ten_cong_trinh || `Công trình ${request.cong_trinh_id}` %></td>
                <td><%= request.khu_vuc || '—' %></td>
                <td><%= request.den_ngay_hien_tai ? new Date(request.den_ngay_hien_tai).toLocaleDateString('vi-VN') : 'Không giới hạn' %></td>
                <td><%= request.den_ngay_moi ? new Date(request.den_ngay_moi).toLocaleDateString('vi-VN') : '—' %></td>
                <td style="white-space: pre-wrap; min-width: 240px;"><%= request.ly_do %></td>
                <td><%= request.ngay_tao ? new Date(request.ngay_tao).toLocaleString('vi-VN') : '—' %></td>
                <td>
                  <form method="post" action="/cong-trinh/gia-han-cho-duyet/<%= request.id %>/duyet" onsubmit="return confirm('Duyệt gia hạn và cập nhật ngày kết thúc phân công?');">
                    <button class="btn btn-sm btn-primary" type="submit">Duyệt gia hạn</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
