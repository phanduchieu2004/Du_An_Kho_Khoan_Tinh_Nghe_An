  hat_002_006: 'Hạt 0,02-0,06 mm',
  hat_0006_002: 'Hạt 0,006-0,02 mm',
  hat_0002_0006: 'Hạt 0,002-0,006 mm',
  hat_duoi_0002: 'Hạt nhỏ hơn 0,002 mm',
  cap_ap_luc_025: 'Cấp áp lực 0,25',
  cap_ap_luc_05: 'Cấp áp lực 0,5',
