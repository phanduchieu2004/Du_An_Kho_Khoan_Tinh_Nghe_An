  cap_ap_luc_2: 'Cấp áp lực 2',
  cap_ap_luc_4: 'Cấp áp lực 4',
  ghi_chu: 'Ghi chú',
};
const isProjectList = columns.includes('id') && columns.includes('ten_cong_trinh');
const recordTable = isProjectList ? 'cong_trinh'
  : columns.includes('ma_ho_khoan') ? 'ho_khoan'
  : columns.includes('ten_lop') ? 'lop_dat'
  : columns.includes('so_hieu_mau') ? 'mau_thi_nghiem'
  : columns.includes('cuoi_dam_200_300') ? 'thanh_phan_hat'
  : columns.includes('cap_ap_luc_025') ? 'cat_phang'
  : columns.includes('suc_chiu_tai_ro') ? 'gia_tri_trung_binh_lop'
  : columns.includes('ten_dang_nhap') ? 'nguoi_dung'
  : columns.includes('ten_vai_tro') ? 'vai_tro'
  : columns.includes('ten_mat_bang') ? 'mat_bang'
  : null;
const showActionColumn = Boolean(
  recordTable && !(isProjectList && currentUser?.role === 'ky-su'),
);
const recordPrimaryKey = columns.includes('ma_nguoi_dung') ? 'ma_nguoi_dung'
  : columns.includes('ma_vai_tro') ? 'ma_vai_tro' : 'id';

function formatDateTime(value) {
  if (!(value instanceof Date) && typeof value !== 'string' && typeof value !== 'number') {
    return value;
  }

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) {
    return value;
  }

  const parts = new Intl.DateTimeFormat('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh',
    hourCycle: 'h23',
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
  }).formatToParts(date);
  const part = (type) => parts.find((item) => item.type === type)?.value ?? '';

  return `${part('hour')}:${part('minute')}:${part('second')} ${part('day')}/${part('month')}/${part('year')}`;
}
%>
<!DOCTYPE html>
<html lang="vi">
