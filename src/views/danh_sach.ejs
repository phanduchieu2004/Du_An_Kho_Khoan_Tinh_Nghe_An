  hat_2_5: 'Hạt 2-5 mm',
  hat_1_2: 'Hạt 1-2 mm',
  hat_05_1: 'Hạt 0,5-1 mm',
  hat_025_05: 'Hạt 0,25-0,5 mm',
  hat_008_025: 'Hạt 0,08-0,25 mm',
