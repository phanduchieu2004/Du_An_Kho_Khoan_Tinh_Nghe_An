  soi_150_200: 'Sỏi 150-200 mm',
  soi_100_150: 'Sỏi 100-150 mm',
  hat_50_100: 'Hạt 50-100 mm',
  hat_20_50: 'Hạt 20-50 mm',
  hat_10_20: 'Hạt 10-20 mm',
