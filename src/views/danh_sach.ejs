  </header>
  <% } %>
  <%- include('thanh-phan/nut_uy_quyen') %>
  <main>
    <% if (typeof createdPendingApproval !== 'undefined' && createdPendingApproval) { %>
      <div class="alert alert-success mt-3" role="status">
        Công trình đã được gửi thành công và đang chờ Quản trị viên duyệt.
      </div>
    <% } %>
    <div class="page-heading">
      <h1><%= title %></h1>
     <div class="search-container">

  <input
    type="text"
    id="search-address"
    class="form-control"
    placeholder="Tìm theo địa chỉ, phường, xã, thành phố..."
  >

  <div
    id="suggestions"
    class="list-group">
  </div>

</div>
<div class="heading-actions">
  <% if (typeof createUrl !== 'undefined') { %>
          <a class="btn btn-success" href="<%= createUrl %>"><%= typeof createLabel !== 'undefined' ? createLabel : '+ Thêm dự án mới' %></a>
        <% } %>
        <% if (recordTable) { %>
          <button class="btn btn-outline-success" id="exportSelectedRows" type="button">Xuất hàng đã chọn (.xlsx)</button>
        <% } %>
        <span class="count"><%= data.length %> bản ghi</span>
      </div>
    </div>
    <div class="table-frame">
      <table class="table table-hover table-striped table-bordered align-middle">
        <thead>
          <tr>
            <% if (recordTable) { %>
              <th scope="col" class="text-center">
                <input class="form-check-input" id="selectAllRows" type="checkbox" aria-label="Chọn tất cả hàng trên trang">
              </th>
            <% } %>
            <% columns.forEach((column) => { %>
              <th scope="col"><%= columnLabels[column] ?? column %></th>
            <% }) %>
            <% if (showActionColumn) { %><th scope="col">Thao tác</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (data.length === 0) { %>
            <tr><td class="empty" colspan="<%= columns.length + (recordTable ? 1 : 0) + (showActionColumn ? 1 : 0) %>">Chưa có dữ liệu.</td></tr>
          <% } else { %>
            <% data.forEach((row, rowIndex) => { %>
              <tr<% if (isProjectList && !(currentUser?.role === 'ky-su' && row.trang_thai_phan_cong === 'Chưa phân công')) { %> class="project-row" tabindex="0" role="link" aria-label="Xem chi tiết công trình <%= row.ten_cong_trinh ?? row.id %>" data-detail-url="/cong-trinh/<%= row.id %>/chi-tiet"<% } %>>
                <% if (recordTable) { %>
                  <td class="text-center">
                    <input class="form-check-input export-row-checkbox" type="checkbox" aria-label="Chọn hàng <%= rowIndex + 1 %>">
                  </td>
                <% } %>
                <% columns.forEach((column) => { %>
                  <td>
                    <% if (column === 'hang_muc' && row[column] && row.id) { %>
                      <a href="/cong-trinh/<%= row.id %>/tai-lieu" title="Xem và tải tài liệu của hạng mục"><%= row[column] %></a>
                    <% } else if (isProjectList && column === 'id') { %>
                      <%= rowIndex + 1 %>
                    <% } else if (isProjectList && column === 'trang_thai_phan_cong') { %>
                      <span class="badge <%= row[column] === 'Đã hoàn thành' ? 'text-bg-success' : row[column] === 'Đang thực hiện' ? 'text-bg-primary' : row[column] === 'Đã kết thúc' ? 'text-bg-secondary' : 'text-bg-light' %>"><%= row[column] ?? 'Chưa phân công' %></span>
                    <% } else { %>
                      <%= ['ngay_tao', 'ngay_cap_nhat'].includes(column) ? formatDateTime(row[column]) ?? '' : row[column] ?? '' %>
                    <% } %>
                  </td>
                <% }) %>
                <% if (showActionColumn) { %>
                  <% const rowId = row[recordPrimaryKey]; %>
                  <td>
                    <div class="row-actions">
                      <% if (isProjectList) { %>
                        <% if (currentUser?.role === 'ky-su' && row.trang_thai_phan_cong === 'Chưa phân công') { %>
