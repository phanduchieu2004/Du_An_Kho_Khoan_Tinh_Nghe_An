    .admin-submenu { position: absolute; top: calc(100% + 8px); left: 0; z-index: 10; display: grid; min-width: 220px; padding: 6px; border: 1px solid var(--line); border-radius: 8px; background: white; box-shadow: 0 10px 28px #19332e24; }
    .admin-menu .admin-submenu a { padding: 10px; border-radius: 5px; color: var(--ink); }
    .admin-menu .admin-submenu a:hover { background: #edf5f1; }
    .admin-session { display: flex; align-items: center; gap: 12px; color: #e2eee9; font-size: 12px; white-space: nowrap; }
    .admin-session form { margin: 0; }
    .admin-session button { padding: 9px 13px; border: 0; border-radius: 8px; background: #fff; color: #19332e; font-weight: 700; }
    .brand { color: white; font-size: 18px; font-weight: 700; text-decoration: none; white-space: nowrap; }
    .nav-links { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
    .nav-links a { color: #e2eee9; text-decoration: none; padding: 7px 10px; border-radius: 5px; font-size: 13px; }
    .nav-links a:hover { color: white; background: #ffffff1c; }
    main { max-width: 1440px; margin: 0 auto; padding: 28px 24px 48px; }
