            <thead>
              <tr><th>Mã công trình</th><th>Tên công trình</th><th>Địa điểm</th><th>Lý do hủy</th><th>Ngày gửi</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
              <% if (pendingCancellationRequests.length === 0) { %>
                <tr><td class="empty" colspan="6">Không có công trình nào đang chờ duyệt hủy phân công.</td></tr>
              <% } else { %>
                <% pendingCancellationRequests.forEach((request) => { %>
                  <tr>
                    <td><%= request.cong_trinh_id %></td>
                    <td><%= request.ten_cong_trinh || `Công trình ${request.cong_trinh_id}` %></td>
                    <td><%= request.dia_diem || '—' %></td>
                    <td><%= request.ly_do || '—' %></td>
                    <td><%= request.ngay_tao ? formatDateTime(request.ngay_tao) : '—' %></td>
                    <td><span class="badge text-bg-warning">Chờ duyệt</span></td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
  </main>
</body>
<script>

const selectAllRows = document.getElementById('selectAllRows');
document.querySelectorAll('.project-row').forEach((row) => {
  const openProject = (event) => {
    if (event.target.closest('a, button, form, input, label')) {
      return;
    }
    window.location.href = row.dataset.detailUrl;
  };

  row.addEventListener('click', openProject);
  row.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      window.location.href = row.dataset.detailUrl;
    }
  });
});

const exportRowCheckboxes = Array.from(
  document.querySelectorAll('.export-row-checkbox')
);

if (selectAllRows) {
  selectAllRows.addEventListener('change', () => {
    selectAllRows.indeterminate = false;
    exportRowCheckboxes
      .filter((checkbox) => !checkbox.closest('tr').hidden)
      .forEach((checkbox) => {
        checkbox.checked = selectAllRows.checked;
      });
  });

  exportRowCheckboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const visibleCheckboxes = exportRowCheckboxes.filter(
        (item) => !item.closest('tr').hidden
      );
      selectAllRows.checked =
        visibleCheckboxes.length > 0 &&
        visibleCheckboxes.every((item) => item.checked);
      selectAllRows.indeterminate =
        visibleCheckboxes.some((item) => item.checked) &&
        !selectAllRows.checked;
    });
  });
}

const exportSelectedRowsButton = document.getElementById('exportSelectedRows');
if (exportSelectedRowsButton) {
  exportSelectedRowsButton.addEventListener('click', async () => {
    const selectedRows = exportRowCheckboxes.filter((checkbox) => checkbox.checked);
    if (selectedRows.length === 0) {
      window.alert('Vui lòng chọn ít nhất một hàng cần xuất.');
      return;
    }

    const table = document.querySelector('.table-frame table');
    const headers = Array.from(table.tHead.rows[0].cells)
      .slice(1, 1 + <%= columns.length %>)
      .map((cell) => cell.innerText.trim());
    const rows = selectedRows.map((checkbox) =>
      Array.from(checkbox.closest('tr').cells)
        .slice(1, 1 + <%= columns.length %>)
        .map((cell) => cell.innerText.trim())
    );

    exportSelectedRowsButton.disabled = true;
    try {
      const response = await fetch('/xuat-file/trang-hien-tai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ headers, rows })
      });
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const fileUrl = URL.createObjectURL(await response.blob());
      const downloadLink = document.createElement('a');
      const pageName = document.querySelector('main h1').innerText
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-zA-Z0-9]+/g, '-')
        .replace(/^-|-$/g, '')
        .toLowerCase();
      downloadLink.href = fileUrl;
      downloadLink.download = `${pageName || 'du-lieu'}-da-chon.xlsx`;
      downloadLink.click();
      setTimeout(() => URL.revokeObjectURL(fileUrl), 1000);
    } catch (error) {
      console.error('Không thể xuất dữ liệu đang chọn:', error);
      window.alert('Không thể xuất file Excel. Vui lòng thử lại.');
    } finally {
      exportSelectedRowsButton.disabled = false;
    }
  });
}

const searchInput =
  document.getElementById(
    'search-address'
  );

const suggestions =
  document.getElementById(
    'suggestions'
  );

searchInput.addEventListener(
  'input',

  async function () {

    const keyword =
      this.value.trim();

    if (keyword.length < 2) {

      suggestions.innerHTML = '';

      filterTable('');

      return;
    }

    const response =
      await fetch(
        '/cong-trinh/tim-dia-chi?keyword='
        + encodeURIComponent(
            keyword
          )
      );

    const data =
      await response.json();

    suggestions.innerHTML = '';

    data.forEach(item => {

      const btn =
        document.createElement(
          'button'
        );

      btn.type = 'button';

      btn.className =
        'list-group-item list-group-item-action';

      btn.textContent =
        item.dia_diem;

      btn.onclick = () => {

        searchInput.value =
          item.dia_diem;

        suggestions.innerHTML =
          '';

        filterTable(
          item.dia_diem
        );
      };

      suggestions.appendChild(
        btn
      );
    });

    filterTable(keyword);
  }
);

function filterTable(
  keyword
) {

  const rows =
    document.querySelectorAll(
      'tbody tr'
    );

  rows.forEach(row => {

    const text =
      row.innerText.toLowerCase();

    row.style.display =
      text.includes(
        keyword.toLowerCase()
      )
      ? ''
      : 'none';
  });
}

</script>
