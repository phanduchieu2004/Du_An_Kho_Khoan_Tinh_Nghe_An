<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    .topbar { background: #173c34; color: white; }
    .topbar-inner { max-width: 1100px; margin: 0 auto; padding: 16px 24px; }
    .brand { color: white; font-size: 18px; font-weight: 700; text-decoration: none; }
    main { max-width: 1100px; margin: 0 auto; padding: 30px 24px 48px; }
    .card { border-color: #dce5e1; }
    .file-name { font-weight: 600; }
    .file-meta { color: #667772; font-size: 13px; }
    @media (max-width: 600px) { main { padding: 22px 14px 36px; } }
  </style>
</head>
<body>
  <%- include('thanh-phan/dau_trang_cong') %>
  <main>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <div class="text-secondary">Công trình: <%= project.ten_cong_trinh %></div>
        <h1 class="h3 mb-0">Tài liệu hạng mục: <%= project.hang_muc || 'Chưa đặt tên' %></h1>
      </div>
      <a class="btn btn-outline-success" href="/cong-trinh/danh-sach">Quay lại danh sách</a>
    </div>

    <% if (typeof uploadedCount === 'number' && uploadedCount > 0) { %>
      <div class="alert alert-success" role="status">
        Đã tải lên thành công <strong><%= uploadedCount %></strong> file. Bấm “Tải xuống” bên cạnh file để lưu về máy.
      </div>
    <% } else if (typeof uploadedCount === 'number' && uploadedCount === 0) { %>
      <div class="alert alert-warning" role="status">
        Công trình đã được tạo nhưng biểu mẫu không nhận được file nào. Quay lại tạo công trình và chọn file ở bước “Tải tài liệu”.
      </div>
    <% } %>

    <% if (typeof importedHoles === 'number' && typeof importedSamples === 'number') { %>
      <div class="alert alert-success" role="status">
        Đã nhập Excel: <strong><%= importedHoles %></strong> hố khoan mới và
        <strong><%= importedSamples %></strong> mẫu thí nghiệm (bao gồm mẫu cập nhật), cùng các dữ liệu lớp đất, thành phần hạt, cắt phẳng và giá trị trung bình lớp.
      </div>
    <% } %>

    <% if (documents.length === 0) { %>
      <div class="alert alert-info">Công trình này chưa có file tài liệu nào được lưu trong hệ thống.</div>
    <% } else { %>
      <div class="card">
        <ul class="list-group list-group-flush">
          <% documents.forEach((document) => { %>
            <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
              <div>
                <div class="file-name"><%= document.ten_file %></div>
                <div class="file-meta"><%= document.loai_tai_lieu %> · <%= (Number(document.kich_thuoc) / 1024 / 1024).toFixed(2) %> MB</div>
              </div>
              <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-success btn-sm" href="/cong-trinh/<%= project.id %>/tai-lieu/<%= document.id %>" download>
                  Tải xuống
                </a>
                <a class="btn btn-outline-primary btn-sm" href="/records/cong_trinh_tai_lieu/<%= document.id %>/edit">Sửa</a>
                <form method="post" action="/records/cong_trinh_tai_lieu/<%= document.id %>/delete"
                  onsubmit="return confirm('Xóa tài liệu này?');">
                  <button class="btn btn-outline-danger btn-sm" type="submit">Xóa</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </main>
</body>
</html>
