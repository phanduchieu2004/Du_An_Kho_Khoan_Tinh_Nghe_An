<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f2f7f4" />
  <title>Đăng nhập <%= role.title %> | Hồ Khoan</title>
  <style>
    :root { color-scheme: light; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #19332e; background: #f2f7f4; }
    * { box-sizing: border-box; }
    body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px 16px; }
    a { color: inherit; }
    .card { width: min(100%, 440px); padding: 34px; border: 1px solid #e0ebe5; border-radius: 20px; background: #fff; box-shadow: 0 20px 55px #19332e12; }
    .back { display: inline-block; margin-bottom: 28px; color: #52716a; font-size: 13px; text-decoration: none; }
    .back:hover { color: #08745e; }
    .eyebrow { margin: 0 0 9px; color: #08745e; font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
    h1 { margin: 0 0 8px; font-size: 29px; letter-spacing: -.8px; }
    .intro { margin: 0 0 25px; color: #6e817b; font-size: 14px; line-height: 1.6; }
    label { display: block; margin: 16px 0 7px; font-size: 13px; font-weight: 700; }
    input { width: 100%; height: 46px; padding: 0 13px; border: 1px solid #dce7e1; border-radius: 10px; background: #fbfdfc; color: #19332e; font: inherit; }
    input:focus { border-color: #54a98e; outline: 3px solid #d9f1e8; }
    .submit { width: 100%; min-height: 46px; margin-top: 22px; border: 0; border-radius: 10px; background: #08745e; color: #fff; font: inherit; font-weight: 750; cursor: pointer; }
    .submit:hover { background: #075f4d; }
    .notice { margin: 18px 0 0; padding: 12px 13px; border: 1px solid #f0dfb5; border-radius: 10px; background: #fff9e9; color: #755c21; font-size: 12px; line-height: 1.55; }
    .error { margin: 16px 0 0; color: #a33131; font-size: 13px; }
    .register { margin: 18px 0 0; text-align: center; color: #6e817b; font-size: 13px; }
    .register a { color: #08745e; font-weight: 750; }
    .footer { margin: 20px 0 0; text-align: center; color: #82918c; font-size: 12px; }
    @media (max-width: 480px) { .card { padding: 26px 21px; } }
  </style>
</head>
<body>
  <main class="card">
    <a class="back" href="/dang-nhap">← Chọn cổng khác</a>
    <p class="eyebrow">Cổng truy cập</p>
    <h1><%= role.title %></h1>
    <p class="intro"><%= role.description %></p>
    <form action="/dang-nhap/<%= role.slug %>" method="post">
      <label for="username">Tên đăng nhập</label>
      <input id="username" name="username" type="text" autocomplete="username" placeholder="Nhập tên đăng nhập" value="<%= username || '' %>" maxlength="100" required />
      <label for="password">Mật khẩu</label>
      <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" maxlength="255" required />
      <button class="submit" type="submit">Đăng nhập</button>
    </form>
    <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
    <% if (role.slug === 'ky-su' || role.slug === 'nguoi-xem-ban-do') { %><p class="register">Chưa có tài khoản? <a href="/dang-ky/<%= role.slug %>">Đăng ký tại đây</a></p><% } %>
    <p class="footer"><a href="/">Về trang bản đồ</a></p>
  </main>
</body>
</html>
