<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    header { min-height: 72px; padding: 12px 30px; display: flex; align-items: center; gap: 20px; background: #057362; color: #fff; }
    header a { color: inherit; text-decoration: none; }
    header strong { margin-right: auto; font-size: 19px; }
    header form { margin: 0; }
    header button { padding: 9px 13px; border: 0; border-radius: 8px; background: #fff; color: #19332e; font-weight: 700; }
    main { width: min(900px, calc(100% - 32px)); margin: 28px auto; padding: 26px; background: #fff; border: 1px solid #dce5e1; border-radius: 12px; }
    @media (max-width: 650px) { header { padding: 12px 16px; } main { padding: 18px; margin: 18px auto; } }
  </style>
</head>
<body>
  <header>
    <strong>Quản lý khu vực</strong>
    <a href="/ho-tro">Hộp thư hỗ trợ</a>
    <a href="/quan-ly-khu-vuc">Danh sách tài khoản</a>
    <form action="/dang-xuat" method="post"><button type="submit">Đăng xuất</button></form>
  </header>
  <main>
    <a href="/quan-ly-khu-vuc" class="text-decoration-none">← Danh sách tài khoản</a>
    <h1 class="h3 mt-3 mb-1"><%= title %></h1>
    <p class="text-secondary mb-4">@<%= account.ten_dang_nhap %> · <%= account.cong_vai_tro.includes('ky-su') ? 'Kỹ sư' : 'Người xem bản đồ' %></p>
    <form method="post" action="/quan-ly-khu-vuc/<%= account.ma_nguoi_dung %>/cap-nhat">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="fullName">Họ tên</label>
          <input class="form-control" id="fullName" name="ho_ten" value="<%= account.ho_ten || '' %>" maxlength="255" required />
        </div>
        <div class="col-md-6">
          <label class="form-label" for="email">Email</label>
          <input class="form-control" id="email" name="email" type="email" value="<%= account.email || '' %>" maxlength="255" />
        </div>
        <div class="col-12">
          <label class="form-label" for="address">Địa chỉ liên hệ</label>
          <textarea class="form-control" id="address" name="dia_chi" rows="2"><%= account.dia_chi || '' %></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="phone">Số điện thoại</label>
          <input class="form-control" id="phone" name="so_dien_thoai" value="<%= account.so_dien_thoai || '' %>" maxlength="20" />
        </div>
        <% if (account.cong_vai_tro.includes('ky-su')) { %>
          <div class="col-md-6">
            <label class="form-label" for="engineerCode">Mã kỹ sư</label>
            <input class="form-control" id="engineerCode" name="ma_ky_su" value="<%= account.ma_ky_su || '' %>" maxlength="50" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="specialty">Chuyên ngành</label>
            <input class="form-control" id="specialty" name="chuyen_nganh" value="<%= account.chuyen_nganh || '' %>" maxlength="100" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="organization">Đơn vị công tác</label>
            <input class="form-control" id="organization" name="don_vi_cong_tac" value="<%= account.don_vi_cong_tac || '' %>" maxlength="255" />
          </div>
          <div class="col-md-6">
            <label class="form-label" for="certificate">Số chứng chỉ hành nghề</label>
            <input class="form-control" id="certificate" name="so_chung_chi_hanh_nghe" value="<%= account.so_chung_chi_hanh_nghe || '' %>" maxlength="100" />
          </div>
        <% } %>
        <div class="col-md-6">
          <label class="form-label" for="status">Trạng thái hồ sơ</label>
          <select class="form-select" id="status" name="trang_thai">
            <% [['CHO_DUYET', 'Chờ duyệt'], ['DA_DUYET', 'Đã duyệt'], ['TU_CHOI', 'Từ chối']].forEach(([value, label]) => { %>
              <option value="<%= value %>" <%= account.trang_thai === value ? 'selected' : '' %>><%= label %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="password">Mật khẩu mới (để trống nếu không đổi)</label>
          <input class="form-control" id="password" name="mat_khau" type="password" minlength="8" maxlength="255" autocomplete="new-password" />
        </div>
        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" id="enabled" name="duoc_dang_nhap" type="checkbox" value="true" <%= account.duoc_dang_nhap ? 'checked' : '' %> />
            <label class="form-check-label" for="enabled">Cho phép tài khoản đăng nhập</label>
          </div>
        </div>
      </div>
      <p class="form-text mt-3">Vai trò và khu vực phân công chỉ do Admin quản lý. Tài khoản này được chọn vì vị trí ghim hiện nằm trong khu vực được giao.</p>
      <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-success" type="submit">Lưu thay đổi</button>
        <a class="btn btn-outline-secondary" href="/quan-ly-khu-vuc">Hủy</a>
      </div>
    </form>
  </main>
</body>
</html>
