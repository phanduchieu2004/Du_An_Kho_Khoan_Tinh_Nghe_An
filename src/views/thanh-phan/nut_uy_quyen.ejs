<% if (typeof pageButtons !== 'undefined' && pageButtons.length > 0) { %>
  <style>
    .authorized-shortcuts { display: flex; flex-wrap: wrap; gap: 8px; padding: 12px 24px; border-bottom: 1px solid #dce5e1; background: #f5faf7; }
    .authorized-shortcuts a { display: inline-flex; align-items: center; padding: 8px 13px; border: 1px solid #b8d8cb; border-radius: 7px; background: #fff; color: #12624d; font-size: 13px; font-weight: 650; text-decoration: none; }
    .authorized-shortcuts a:hover, .authorized-shortcuts a:focus-visible { border-color: #17785f; background: #eaf6f1; }
    @media (max-width: 650px) { .authorized-shortcuts { padding: 10px 14px; } }
  </style>
  <nav class="authorized-shortcuts" aria-label="Chức năng được ủy quyền">
    <% pageButtons.forEach((button) => { %>
      <a href="<%= button.path %>"><%= button.title %></a>
    <% }); %>
  </nav>
<% } %>
