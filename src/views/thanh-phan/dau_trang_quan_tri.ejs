<style>
  .account-portal-header {
    min-height: 76px;
    padding: 12px 30px;
    display: flex;
    align-items: center;
    gap: 22px;
    background: #057362;
    color: #fff;
  }
  .account-portal-header a { color: inherit; text-decoration: none; }
  .account-portal-brand { flex: none; font-size: 20px; font-weight: 700; white-space: nowrap; }
  .account-portal-nav { display: flex; flex: 1; align-items: center; gap: 5px; }
  .account-portal-nav a { padding: 11px 12px; border-radius: 5px; font-size: 14px; white-space: nowrap; }
  .account-portal-nav a:hover { background: #ffffff26; }
  .account-portal-header .profile-button { color: #e2eee9; }
  .account-portal-logout { margin: 0; }
  .account-portal-logout button { padding: 9px 13px; border: 0; border-radius: 8px; background: #fff; color: #19332e; font-weight: 700; white-space: nowrap; }
  @media (max-width: 850px) {
    .account-portal-header { flex-wrap: wrap; gap: 8px 14px; padding: 12px 16px; }
    .account-portal-nav { order: 3; flex-basis: 100%; overflow-x: auto; }
    .account-portal-header .profile-button { margin-left: auto; }
  }
</style>
<header class="account-portal-header">
  <a class="account-portal-brand" href="/">Hồ sơ khoan địa chất</a>
  <nav class="account-portal-nav" aria-label="Điều hướng quản trị">
    <a href="/">Bản đồ</a>
    <a href="/cong-trinh/danh-sach">Quản lý công trình</a>
    <a href="/nguoi-dung">Quản lý người dùng</a>
    <a href="/ho-tro">Hộp thư hỗ trợ</a>
  </nav>
  <%- include('nut_ho_so') %>
  <form action="/dang-xuat" method="post" class="account-portal-logout">
    <button type="submit">Đăng xuất</button>
  </form>
</header>
<%- include('thanh_dieu_huong_cong_trinh_quan_tri') %>
<%- include('nut_uy_quyen') %>
<script defer src="/js/bo-loc-bang.js"></script>
