<% if (currentUser?.role === 'ky-su') { %>
  <%- include('thanh_dieu_huong_cong_ky_su') %>
<% } else if (currentUser?.role === 'quan-tri-vien') { %>
  <%- include('dau_trang_quan_tri') %>
<% } else { %>
  <style>
    .viewer-portal-header {
      min-height: 76px;
      padding: 12px 30px;
      display: flex;
      align-items: center;
      gap: 22px;
      background: #057362;
      color: #fff;
    }
    .viewer-portal-header a { color: inherit; text-decoration: none; }
    .viewer-portal-brand { margin-right: auto; font-size: 20px; font-weight: 700; white-space: nowrap; }
    .viewer-portal-logout { margin: 0; }
    .viewer-portal-logout button { padding: 9px 13px; border: 0; border-radius: 8px; background: #fff; color: #19332e; font-weight: 700; white-space: nowrap; }
    @media (max-width: 600px) {
      .viewer-portal-header { gap: 10px; padding: 12px 16px; }
      .viewer-portal-brand { font-size: 17px; }
    }
  </style>
  <header class="viewer-portal-header">
    <a class="viewer-portal-brand" href="/">Hồ sơ khoan địa chất</a>
    <%- include('nut_ho_so') %>
    <% if (currentUser) { %>
      <form action="/dang-xuat" method="post" class="viewer-portal-logout">
        <button type="submit">Đăng xuất</button>
      </form>
    <% } else { %>
      <a class="viewer-portal-logout" href="/dang-nhap">Đăng nhập</a>
    <% } %>
  </header>
  <%- include('nut_uy_quyen') %>
  <script defer src="/js/bo-loc-bang.js"></script>
<% } %>
