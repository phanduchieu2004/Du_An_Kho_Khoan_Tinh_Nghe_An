      showToast('Đã tìm thấy vị trí của bạn.');
    });
    map.on('locationerror', () => showToast('Không thể xác định vị trí. Hãy kiểm tra quyền truy cập vị trí.'));

    const searchForm = document.getElementById('searchForm');
    const searchInput = document.getElementById('searchInput');
    const resultsBox = document.getElementById('searchResults');
    let searchMarker;
    let searchBoundary;
    let searchBoundaryGeometry = null;
    const tourismLayer = L.layerGroup();
    const maxTourismResults = 200;
    let searchController;
    let vietnamLandMaskPromise;
    let searchSelectionId = 0;
    let lastSearchAt = 0;
    async function getVietnamLandMask() {
      if (!vietnamLandMaskPromise) {
        vietnamLandMaskPromise = fetch('/du-lieu/ranh-gioi-viet-nam.geojson')
          .then(response => {
            if (!response.ok) throw new Error(`Không tải được dữ liệu đất liền Việt Nam (HTTP ${response.status}).`);
            return response.json();
          })
          .then(geometry => {
            if (!geometry || geometry.type !== 'MultiPolygon' || !Array.isArray(geometry.coordinates)) {
              throw new Error('Dữ liệu đất liền Việt Nam không hợp lệ.');
            }
            return geometry;
          });
      }
      return vietnamLandMaskPromise;
    }
    function isAreaGeometry(geometry) {
      return geometry &&
        (geometry.type === 'Polygon' || geometry.type === 'MultiPolygon') &&
        Array.isArray(geometry.coordinates) &&
        geometry.coordinates.length > 0;
    }
    function searchPopupContent(result, latitude, longitude) {
      const container = document.createElement('div');
      const heading = document.createElement('div');
      const title = document.createElement('strong');
      const actions = document.createElement('div');
      const detailsButton = document.createElement('button');
      const description = document.createElement('p');
      heading.className = 'mat-bang-popup-heading';
      title.className = 'popup-title';
      title.textContent = result.name || result.display_name.split(',')[0];
      actions.className = 'mat-bang-popup-actions';
      detailsButton.type = 'button';
