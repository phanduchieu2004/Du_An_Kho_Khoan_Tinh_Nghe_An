  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@turf/turf@7.2.0/turf.min.js"></script>
  <script>
    const places = [
      { name: 'Hà Nội', detail: 'Thủ đô · Miền Bắc', description: 'Thủ đô ngàn năm văn hiến của Việt Nam.', lat: 21.0285, lng: 105.8542, zoom: 13 },
      { name: 'Đà Nẵng', detail: 'Thành phố biển · Miền Trung', description: 'Thành phố ven biển với những cây cầu nổi tiếng.', lat: 16.0544, lng: 108.2022, zoom: 13 },
      { name: 'TP. Hồ Chí Minh', detail: 'Đô thị sôi động · Miền Nam', description: 'Trung tâm kinh tế năng động của Việt Nam.', lat: 10.8231, lng: 106.6297, zoom: 13 },
      { name: 'Hội An', detail: 'Phố cổ · Quảng Nam', description: 'Di sản văn hóa với những con phố rực rỡ ánh đèn.', lat: 15.8801, lng: 108.3380, zoom: 15 }
    ];

    const initialMapCenter = [16.15, 106.15];
    const initialMapZoom = 6;
    const map = L.map('map', { zoomControl: false }).setView(initialMapCenter, initialMapZoom);
    let hoKhoanMarkers = [];
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'
    }).addTo(map);
    L.control.zoom({ position: 'topright', zoomInTitle: 'Phóng to', zoomOutTitle: 'Thu nhỏ' }).addTo(map);
    const mapHomeButton = document.getElementById('mapHomeButton');
    const mapCenterMarker = document.getElementById('mapCenterCircle');
    const mapCenterCross = document.getElementById('mapCenterCross');
    const mapLayout = document.querySelector('.map-layout');
    const holeScanResults = document.getElementById('holeScanResults');
    const holeScanCount = document.getElementById('holeScanCount');
    const holeScanResultsBody = document.getElementById('holeScanResultsBody');
    const holeScanPinnedCoordinates = document.getElementById('holeScanPinnedCoordinates');
    const holeScanEmpty = document.getElementById('holeScanEmpty');
    const holeScanExport = document.getElementById('holeScanExport');
    const holeScanRadius = 5000;
    const holeScanLayer = L.layerGroup();
    let holeScanData = null;
    let holeScanEnabled = false;

    function updateHoleScan(announce = false) {
      if (!holeScanEnabled || !holeScanData) return;

      const center = map.getCenter();
      holeScanLayer.clearLayers();
      holeScanResultsBody.replaceChildren();
      holeScanPinnedCoordinates.textContent =
        `${center.lat.toFixed(6)}, ${center.lng.toFixed(6)}`;
      const nearbyHoles = [];

      holeScanData.forEach(hole => {
        if (
          !hole || hole.latitude == null || hole.longitude == null ||
          hole.latitude === '' || hole.longitude === ''
        ) return;

        const latitude = Number(hole.latitude);
        const longitude = Number(hole.longitude);
        if (
          !Number.isFinite(latitude) || !Number.isFinite(longitude) ||
          latitude < -90 || latitude > 90 ||
          longitude < -180 || longitude > 180
        ) return;

        const distance = map.distance(center, L.latLng(latitude, longitude));
        if (distance > holeScanRadius) return;

        const marker = L.marker([latitude, longitude], {
          icon: window.createBoreholeIcon()
        });
        const popup = document.createElement('div');
        const title = document.createElement('strong');
        const project = document.createElement('div');
        title.textContent = hole.ma_ho_khoan || `Hố khoan ${hole.id}`;
        project.textContent = `Công trình: ${hole.ten_cong_trinh || `Công trình ${hole.cong_trinh_id}`}`;
        popup.append(title, document.createElement('br'), project);
        marker.bindPopup(popup, { autoPan: false });
        holeScanLayer.addLayer(marker);
        nearbyHoles.push({
          hole,
          distance,
          name: hole.ma_ho_khoan || `Hố khoan ${hole.id}`,
          marker,
          location: L.latLng(latitude, longitude)
        });
      });

      nearbyHoles.sort((first, second) => first.distance - second.distance);
      nearbyHoles.forEach(({ hole, distance, name, marker, location }) => {
        const row = document.createElement('tr');
        const nameCell = document.createElement('td');
        const projectCell = document.createElement('td');
        const distanceCell = document.createElement('td');
        const nameButton = document.createElement('button');
        nameButton.type = 'button';
        nameButton.className = 'hole-scan-name-button';
        nameButton.textContent = name;
        nameButton.setAttribute('aria-label', `Đưa bản đồ đến ${name}`);
        nameButton.addEventListener('click', () => {
          const zoom = Math.max(map.getZoom(), 16);
          if (map.getCenter().equals(location) && map.getZoom() === zoom) {
            marker.openPopup();
            return;
          }
          map.once('moveend', () => marker.openPopup());
          map.flyTo(location, zoom, { duration: 1 });
        });
        nameCell.append(nameButton);
        projectCell.textContent = hole.ten_cong_trinh || (
          hole.cong_trinh_id == null
            ? '—'
            : `Công trình ${hole.cong_trinh_id}`
        );
        distanceCell.textContent = `${(distance / 1000).toLocaleString('vi-VN', {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        })} km`;
        row.append(nameCell, projectCell, distanceCell);
        holeScanResultsBody.append(row);
      });

      holeScanCount.textContent = `${nearbyHoles.length} hố`;
      holeScanExport.disabled = nearbyHoles.length === 0;
      holeScanEmpty.hidden = nearbyHoles.length > 0;
      const status = `Đang quét bán kính 5 km: tìm thấy ${nearbyHoles.length} hố khoan`;
      mapHomeButton.title = status;
      mapHomeButton.setAttribute('aria-label', status);
      if (announce) showToast(`${status}.`);
    }

    function stopHoleScan() {
      holeScanEnabled = false;
      mapLayout.classList.remove('hole-scan-active');
      mapCenterMarker.hidden = true;
      holeScanResults.hidden = true;
      holeScanLayer.clearLayers();
      map.removeLayer(holeScanLayer);
      holeScanResultsBody.replaceChildren();
      holeScanPinnedCoordinates.textContent = 'Chưa quét';
      holeScanCount.textContent = '0 hố';
      holeScanExport.disabled = true;
      holeScanEmpty.hidden = true;
      mapHomeButton.title = 'Quét hố khoan trong bán kính 5 km quanh tâm';
      mapHomeButton.setAttribute(
        'aria-label',
        'Quét hố khoan trong bán kính 5 km quanh tâm'
      );
      mapHomeButton.setAttribute('aria-pressed', 'false');
    }

    window.hideHoleScan = stopHoleScan;
    mapHomeButton.addEventListener('click', async () => {
      mapHomeButton.disabled = true;
      try {
        if (holeScanEnabled) {
          stopHoleScan();
          showToast('Đã tắt tâm quét hố khoan.');
          return;
        }

        holeScanEnabled = true;
        mapLayout.classList.add('hole-scan-active');
        mapCenterMarker.hidden = false;
        mapHomeButton.setAttribute('aria-pressed', 'true');
        showToast('Nhấn dấu + ở tâm bản đồ để quét hố khoan trong 5 km.');
      } catch (error) {
        console.error('Không thể bật tâm quét hố khoan:', error);
        stopHoleScan();
        showToast('Không thể bật tâm quét. Vui lòng thử lại.');
      } finally {
        mapHomeButton.disabled = false;
      }
    });

    mapCenterCross.addEventListener('click', async () => {
      if (!holeScanEnabled) return;

      mapCenterCross.disabled = true;
      try {
        if (!holeScanData) {
          const response = await fetch('/ho-khoan/api');
          if (!response.ok) {
            throw new Error(`API hố khoan trả về HTTP ${response.status}`);
          }
          const data = await response.json();
          if (!Array.isArray(data)) {
            throw new Error('Dữ liệu hố khoan không hợp lệ.');
          }
          holeScanData = data;
        }

        holeScanResults.hidden = false;
        holeScanLayer.addTo(map);
        updateHoleScan(true);
      } catch (error) {
        console.error('Không thể quét hố khoan quanh tâm bản đồ:', error);
        holeScanResults.hidden = true;
        holeScanLayer.clearLayers();
        map.removeLayer(holeScanLayer);
        showToast('Không thể quét hố khoan. Vui lòng thử lại.');
      } finally {
        mapCenterCross.disabled = false;
      }
    });

    holeScanExport.addEventListener('click', () => {
      const rows = [
        ['Tọa độ ghim (WGS84)', holeScanPinnedCoordinates.textContent, ''],
        ['Tên hố khoan', 'Tên công trình', 'Khoảng cách từ tâm +'],
        ...Array.from(holeScanResultsBody.rows, row =>
          Array.from(row.cells, cell => cell.textContent.trim())
        )
      ];
      const escapeCsvCell = value => {
        const safeValue = /^[=+\-@\t\r]/.test(value) ? `'${value}` : value;
        return `"${safeValue.replace(/"/g, '""')}"`;
      };
      const csv = '\uFEFF' + rows
        .map(row => row.map(escapeCsvCell).join(';'))
        .join('\r\n');
      const fileUrl = URL.createObjectURL(
        new Blob([csv], { type: 'text/csv;charset=utf-8' })
      );
      const downloadLink = document.createElement('a');
      downloadLink.href = fileUrl;
      downloadLink.download = 'ho-khoan-trong-ban-kinh-5km.csv';
      downloadLink.click();
      setTimeout(() => URL.revokeObjectURL(fileUrl), 1000);
      showToast('Đã xuất danh sách hố khoan ra file CSV.');
    });

    function pinIcon(type = '') {
      return L.divIcon({ className: '', html: `<div class="map-pin ${type}"><span></span></div>`, iconSize: [34, 40], iconAnchor: [17, 36], popupAnchor: [0, -36] });
    }
    window.createBoreholeIcon = function () {
      return L.divIcon({
        className: '',
        html: '<div class="borehole-pin" aria-hidden="true">' +
          '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
          'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M12 3 6.5 20h11L12 3Z"/>' +
          '<path d="M9 12h6M8 16h8M12 7v13M5 21h14"/>' +
          '</svg></div>',
