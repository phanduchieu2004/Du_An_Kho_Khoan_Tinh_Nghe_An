<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ffffff" />
  <title>Atlas — Khám phá bản đồ Việt Nam</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
  <style>
    :root { --ink: #192b34; --muted: #76868d; --green: #14836e; --green-dark: #0c6d5b; --line: #e8eeed; --surface: #fff; }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; }
    body { font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); background: #e9f1ec; }
    button, input { font: inherit; }
    button { cursor: pointer; }
    button:focus-visible, input:focus-visible, a:focus-visible { outline: 3px solid #80cdb9; outline-offset: 2px; }
    .app { height: 100%; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
    .topbar { height: 76px; flex: none; background: var(--surface); display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 0 30px; position: relative; z-index: 1001; box-shadow: 0 1px 12px #18312612; }
    .brand { display: flex; align-items: center; gap: 11px; flex: none; text-decoration: none; color: var(--ink); }
    .brand-icon { width: 39px; height: 39px; border-radius: 12px; background: var(--green); display: grid; place-items: center; color: white; box-shadow: 0 6px 13px #14836e37; }
    .brand-icon svg { width: 23px; height: 23px; }
    .brand-name { font-size: 23px; font-weight: 800; letter-spacing: -1.3px; }
    .brand-name span { color: var(--green); }
    .search-area { position: relative; width: min(490px, 48vw); }
    .search { height: 44px; display: flex; align-items: center; gap: 10px; border: 1px solid #e2e9e7; background: #f8faf9; border-radius: 11px; padding: 0 6px 0 15px; transition: border-color .2s, box-shadow .2s; }
    .search:focus-within { border-color: #7dbdab; box-shadow: 0 0 0 3px #d9f1e9; }
    .search svg { width: 18px; height: 18px; flex: none; color: #8a9c9b; }
    .search input { border: 0; outline: 0; background: none; flex: 1; width: 0; min-width: 0; color: var(--ink); font-size: 13px; }
    .search input::placeholder { color: #98a8a6; }
    .search button { border: 0; border-radius: 8px; background: var(--green); color: #fff; font-size: 12px; font-weight: 700; padding: 8px 14px; white-space: nowrap; }
    .search button:hover { background: var(--green-dark); }
    .search-results { display: none; position: absolute; top: calc(100% + 9px); left: 0; right: 0; max-height: min(70vh, 560px); border: 1px solid var(--line); border-radius: 13px; background: white; box-shadow: 0 15px 40px #233d3640; overflow-y: auto; }
    .search-results.open { display: block; }
    .search-result { width: 100%; text-align: left; border: 0; border-bottom: 1px solid var(--line); background: white; padding: 12px 15px; color: var(--ink); font-size: 12px; line-height: 1.5; }
    .search-result:hover { background: #f1f8f5; }
    .search-info { margin: 0; padding: 15px; color: var(--muted); font-size: 12px; line-height: 1.5; }
    .search-credit { padding: 9px 15px; color: var(--muted); font-size: 10px; background: #f8faf9; }
    .search-credit a { color: var(--green); }
    .header-right { display: flex; align-items: center; gap: 13px; flex: none; }
    .header-note { font-size: 12px; color: var(--muted); }
    .topbar .profile-button { color: var(--muted); }
    .location-button { height: 40px; display: inline-flex; align-items: center; gap: 8px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: var(--ink); font-size: 12px; font-weight: 700; white-space: nowrap; }
    .location-button:hover { background: #f4f9f7; border-color: #a9d6c9; }
    .location-button svg { width: 17px; height: 17px; color: var(--green); }
    .map-layout { position: relative; flex: 1; min-height: 0; }
    #map { position: absolute; inset: 0; z-index: 1; }
    .explore-panel { position: absolute; z-index: 500; top: 22px; left: 22px; bottom: 22px; width: 320px; display: flex; flex-direction: column; background: #fff; border: 1px solid #edf0ec; border-radius: 17px; box-shadow: 0 14px 40px #30443b2c; overflow: hidden; }
    .panel-top { padding: 27px 23px 20px; border-bottom: 1px solid var(--line); }
    .eyebrow { display: flex; align-items: center; gap: 7px; color: var(--green); font-size: 10px; font-weight: 800; letter-spacing: 1.8px; text-transform: uppercase; margin: 0 0 10px; }
    .eyebrow::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
    h1 { font-size: 25px; line-height: 1.18; letter-spacing: -.9px; margin: 0 0 10px; }
    .panel-top > p:last-child { font-size: 12px; line-height: 1.65; color: var(--muted); margin: 0; }
    .panel-content { overflow-y: auto; padding: 20px 13px 16px; scrollbar-width: thin; }
    .list-label { font-size: 10px; letter-spacing: 1.1px; font-weight: 800; color: #96a4a2; margin: 0 10px 12px; }
    .place-list { display: grid; gap: 5px; }
    .place { width: 100%; padding: 12px 10px; border: 1px solid transparent; border-radius: 11px; background: #fff; display: flex; gap: 11px; text-align: left; align-items: center; transition: background .2s, border-color .2s; }
    .place:hover { background: #f6faf8; }
    .place.active { background: #f1f8f5; border-color: #d7eae3; }
    .place-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; flex: none; color: var(--green); background: #e5f4ee; }
    .place-icon svg { width: 19px; height: 19px; }
    .place:nth-child(2) .place-icon { color: #558fbd; background: #eaf3fb; }
    .place:nth-child(3) .place-icon { color: #c3805b; background: #faf0e8; }
    .place:nth-child(4) .place-icon { color: #aa86b9; background: #f6edf8; }
    .place-text { flex: 1; min-width: 0; }
    .place-text strong { display: block; font-size: 12px; margin-bottom: 4px; }
    .place-text small { color: var(--muted); font-size: 11px; }
    .place-arrow { width: 17px; height: 17px; flex: none; color: #abbab4; }
    .panel-bottom { margin-top: auto; border-top: 1px solid var(--line); padding: 15px 22px; background: #fcfdfc; display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 11px; }
    .panel-bottom svg { width: 15px; height: 15px; color: var(--green); flex: none; }
    .map-tip { position: absolute; z-index: 400; bottom: 25px; left: 360px; border: 1px solid #e8eeeb; border-radius: 9px; padding: 10px 13px; background: #fff; box-shadow: 0 4px 14px #31453c24; font-size: 11px; color: #647972; pointer-events: none; }
    .map-tip strong { color: var(--green); }
    .map-home-button { position: absolute; z-index: 600; top: 22px; left: 360px; width: 42px; height: 42px; display: grid; place-items: center; padding: 0; border: 1px solid #e2e9e7; border-radius: 50%; background: #fff; color: var(--green); box-shadow: 0 4px 16px #263a3440; transition: background .2s, color .2s, transform .2s; }
    .map-home-button:hover { background: var(--green); color: #fff; transform: scale(1.05); }
    .map-home-button svg { width: 22px; height: 22px; }
    .map-center-circle { position: absolute; z-index: 500; top: 50%; left: 50%; width: 80px; height: 80px; border: 2px solid #057362; border-radius: 50%; background: #e287511a; box-shadow: 0 0 0 1px #fff8, inset 0 0 24px #e2875120; transform: translate(-50%, -50%); pointer-events: none; }
    .map-center-cross { position: absolute; top: 50%; left: 50%; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: transparent; transform: translate(-50%, -50%); pointer-events: auto; cursor: crosshair; }
    .map-center-cross::before, .map-center-cross::after { content: ""; position: absolute; top: 50%; left: 50%; border-radius: 2px; background: #d62828; box-shadow: 0 0 2px #fff; transform: translate(-50%, -50%); }
    .map-center-cross::before { width: 12px; height: 2px; }
    .map-center-cross::after { width: 2px; height: 12px; }
    .map-center-circle[hidden] { display: none; }
    .map-layout.hole-scan-active .explore-panel,
    .map-layout.hole-scan-active .map-tip { display: none; }
    .hole-scan-results { position: absolute; z-index: 800; top: 78px; left: 22px; width: min(500px, calc(100% - 44px)); max-height: min(58vh, 500px); display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: 12px; background: #fff; box-shadow: 0 8px 28px #263a3440; }
    .hole-scan-results[hidden] { display: none; }
    .hole-scan-results-heading { display: flex; align-items: center; justify-content: flex-start; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
    .hole-scan-results-heading h2 { flex: 1 1 auto; min-width: 0; margin: 0; font-size: 13px; white-space: nowrap; }
    .hole-scan-count { flex: none; color: var(--green); font-size: 12px; font-weight: 800; }
    .hole-scan-export { flex: none; padding: 7px 10px; border: 1px solid #d7eae3; border-radius: 8px; background: #f1f8f5; color: var(--green-dark); font-size: 11px; font-weight: 700; }
    .hole-scan-export:hover:not(:disabled) { background: #e5f4ee; }
    .hole-scan-export:disabled { cursor: not-allowed; opacity: .5; }
    .hole-scan-table-wrap { overflow: auto; }
    .hole-scan-table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 11px; text-align: left; }
    .hole-scan-table th, .hole-scan-table td { padding: 9px 8px; border-right: 1px solid #dfe7e3; border-bottom: 1px solid #edf1ef; }
    .hole-scan-table th:last-child, .hole-scan-table td:last-child { border-right: 0; }
    .hole-scan-table th { position: sticky; top: 0; background: #f6faf8; color: #647972; font-weight: 700; }
    .hole-scan-table td:nth-child(2) { overflow-wrap: anywhere; }
    .hole-scan-table td:last-child, .hole-scan-table th:last-child { text-align: right; white-space: nowrap; }
    .hole-scan-coordinate-row td { background: #f7fbf9; color: var(--green-dark); font-weight: 700; text-align: left !important; }
    .hole-scan-name-button { padding: 0; border: 0; background: transparent; color: var(--green-dark); font: inherit; font-weight: 700; text-align: left; text-decoration: underline; text-underline-offset: 2px; }
    .hole-scan-name-button:hover { color: var(--green); }
    .hole-scan-empty { padding: 14px; color: var(--muted); font-size: 12px; text-align: center; }
    .leaflet-control-zoom { border: 0 !important; box-shadow: 0 4px 16px #263a3440 !important; overflow: hidden; border-radius: 10px !important; }
    .leaflet-control-zoom a { width: 36px !important; height: 36px !important; line-height: 36px !important; color: var(--ink) !important; border-color: var(--line) !important; }
    .leaflet-control-zoom a:hover { background: #f1f8f5 !important; color: var(--green) !important; }
    .leaflet-top.leaflet-right { margin: 12px 13px 0 0; }
    .leaflet-control-attribution { font-size: 10px !important; background: #ffffffdf !important; }
    .leaflet-control-attribution a { color: var(--green) !important; }
    .map-pin { width: 34px; height: 34px; position: relative; display: grid; place-items: center; border-radius: 50% 50% 50% 5px; background: var(--green); border: 3px solid #fff; box-shadow: 0 3px 13px #172c2c60; transform: rotate(-45deg); }
    .map-pin span { display: block; width: 11px; height: 11px; border-radius: 50%; background: #fff; }
    .map-pin.selected { background: #e28751; }
    .map-pin.user { background: #4488d3; }
    .borehole-pin { width: 38px; height: 38px; display: grid; place-items: center; border: 3px solid #fff; border-radius: 50% 50% 50% 5px; background: #e28751; box-shadow: 0 3px 13px #172c2c60; transform: rotate(-45deg); }
    .borehole-pin svg { width: 21px; height: 21px; transform: rotate(45deg); color: #fff; }
    .popup-title { margin: 0 0 4px; font-weight: 800; color: var(--ink); font-size: 13px; }
    .popup-description { margin: 0; font-size: 11px; line-height: 1.5; color: var(--muted); }
    .mat-bang-popup-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
    .mat-bang-popup-actions { display: flex; align-items: center; gap: 6px; flex: none; }
    .mat-bang-hole-button { width: 32px; height: 32px; display: grid; place-items: center; flex: none; padding: 0; border: 1px solid #d7eae3; border-radius: 8px; background: #f1f8f5; color: var(--green); }
    .mat-bang-hole-button:hover { background: #e5f4ee; }
    .mat-bang-hole-button:disabled { cursor: wait; opacity: .6; }
    .mat-bang-hole-button svg { width: 19px; height: 19px; }
    .mat-bang-detail-button { width: 32px; height: 32px; display: grid; place-items: center; flex: none; padding: 0; border: 1px solid #d7eae3; border-radius: 8px; background: #f1f8f5; color: var(--green); }
    .mat-bang-detail-button:hover { background: #e5f4ee; }
    .mat-bang-detail-button svg { width: 19px; height: 19px; }
    .mat-bang-level-button { display: block; margin-top: 8px; padding: 6px 10px; border: 1px solid #b8dec6; border-radius: 7px; background: #effaf2; color: #16733e; font-size: 11px; font-weight: 700; }
    .mat-bang-level-button:hover { background: #dcf5e3; }
    .mat-bang-level-button:disabled { cursor: wait; opacity: .6; }
    .mat-bang-hole-status { margin: 6px 0 0; color: var(--muted); font-size: 11px; }
    .mat-bang-detail-overlay { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; padding: 20px; background: #10231f80; }
    .mat-bang-detail-overlay[hidden] { display: none; }
    .mat-bang-detail-dialog { width: min(560px, 100%); max-height: min(80vh, 700px); overflow: auto; border-radius: 16px; background: #fff; box-shadow: 0 20px 60px #10231f55; }
    .mat-bang-detail-heading { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--line); background: #fff; }
    .mat-bang-detail-title { margin: 0; font-size: 17px; }
    .mat-bang-detail-close { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--ink); }
    .mat-bang-detail-close:hover { background: #f4f9f7; }
    .mat-bang-detail-close svg { width: 18px; height: 18px; }
    .mat-bang-detail-content { padding: 18px 20px 20px; }
    .mat-bang-detail-list { display: grid; grid-template-columns: minmax(130px, .8fr) 1.2fr; gap: 10px 16px; margin: 0; font-size: 13px; }
    .mat-bang-detail-list dt { color: var(--muted); }
    .mat-bang-detail-list dd { margin: 0; overflow-wrap: anywhere; }
    .mat-bang-detail-section-title { margin: 22px 0 8px; font-size: 13px; }
    .mat-bang-detail-coordinates { max-height: 230px; overflow: auto; margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 9px; background: #f8faf9; color: var(--ink); font: 11px/1.6 Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; }
    .toast { position: absolute; bottom: 25px; left: 50%; z-index: 900; transform: translate(-50%, 12px); opacity: 0; pointer-events: none; background: #1f3733; color: #fff; border-radius: 9px; padding: 11px 16px; box-shadow: 0 8px 20px #263a3440; font-size: 12px; transition: opacity .2s, transform .2s; white-space: nowrap; max-width: 90vw; overflow: hidden; text-overflow: ellipsis; }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }
    @media (max-width: 850px) {
      .topbar { padding: 0 16px; gap: 12px; }
      .header-note { display: none; }
      .search-area { width: auto; flex: 1; }
      .explore-panel { width: 280px; }
      .map-tip { left: 318px; }
      .map-home-button { left: 318px; }
    }
    /* nút chức năng */
    .topbar{
    background:#057362 !important;
    color:#fff;
}

.brand{
    color:#fff !important;
}

.brand-icon{
    background:transparent !important;
    box-shadow:none !important;
    font-size:38px;
}

.brand-name{
    font-size:22px;
    color:#0047cc;
    font-weight:700;
}

.brand-name span{
    color:#00a651;
}

.menu-bar{
    display:flex;
    align-items:center;
    gap:5px;
    flex:1;
    margin-left:30px;
}

.menu-item{
    position:relative;
}

.menu-btn{
    border:none;
    background:transparent;
    color:#fff;
    padding:12px 14px;
    font-size:14px;
    cursor:pointer;
    letter-spacing:1px;
}

.menu-btn:hover{
    background:rgba(255,255,255,0.15);
    border-radius:4px;
}

.submenu{
    display:none;
    position:absolute;
    top:100%;
    left:0;
    min-width:220px;
    background:#fff;
    border-radius:0 0 8px 8px;
    box-shadow:0 5px 15px rgba(0,0,0,.2);
    z-index:9999;
}

.submenu button{
    width:100%;
    text-align:left;
    padding:12px;
    border:none;
    background:#fff;
    color:#333;
    cursor:pointer;
}

.submenu button:hover{
    background:#f3f3f3;
}

.submenu.show{
    display:block;
}

/* Thanh công cụ bên phải */

.map-tools {
    position: absolute;
    top: 120px; /* nằm dưới zoom */
    right: 13px;
    z-index: 999;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
