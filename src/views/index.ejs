    function resultMessage(message) {
      resultsBox.replaceChildren();
      const text = document.createElement('p'); text.className = 'search-info'; text.textContent = message;
      resultsBox.append(text); resultsBox.classList.add('open');
    }
    function parseTourismSearch(query) {
      const prefixes = [
        /^(?:tìm\s+)?(?:các\s+)?(?:địa\s+điểm|điểm)\s+(?:du\s+lịch|tham\s+quan)\s*(?:ở|tại|quanh)?\s*/i,
        /^(?:tìm\s+)?(?:các\s+)?địa\s+điểm\s+du\s+lịch\s*(?:ở|tại|quanh)?\s*/i,
        /^(?:tìm\s+)?du\s+lịch\s*(?:ở|tại|quanh)?\s*/i,
        /^(?:tourist\s+attractions?|tourism)\s*(?:in|near)?\s*/i
      ];
      for (const prefix of prefixes) {
        if (prefix.test(query)) {
          return { location: query.replace(prefix, '').trim(), category: 'du lịch' };
        }
      }
      const suffix = /\s+(?:địa\s+điểm\s+)?du\s+lịch$/i;
      if (suffix.test(query)) {
        return { location: query.replace(suffix, '').trim(), category: 'du lịch' };
      }
      return null;
    }
    function parseWgs84Coordinates(query) {
      const match = query.match(
        /^\s*\(?\s*([+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*[,;\s]\s*([+-]?(?:\d+(?:\.\d*)?|\.\d+))\s*\)?\s*$/
      );
      if (!match) return null;

      const latitude = Number(match[1]);
      const longitude = Number(match[2]);
      if (
        latitude < -90 || latitude > 90 ||
        longitude < -180 || longitude > 180
      ) {
        throw new Error('Tọa độ WGS84 không hợp lệ. Vĩ độ phải từ -90 đến 90, kinh độ từ -180 đến 180.');
      }
      return { latitude, longitude };
    }
    function makeTourismOverpassQuery(location) {
      if (!location) {
        if (map.getZoom() < 10) {
          throw new Error('Hãy phóng to khu vực muốn tìm hoặc nhập ví dụ “du lịch Đà Nẵng”.');
        }
        const bounds = map.getBounds();
        return `[out:json][timeout:25];(nwr["tourism"](${bounds.getSouth()},${bounds.getWest()},${bounds.getNorth()},${bounds.getEast()}););out tags center ${maxTourismResults + 1};`;
      }
      const geocodeUrl = new URL('https://nominatim.openstreetmap.org/search');
      geocodeUrl.search = new URLSearchParams({
        q: location,
        format: 'jsonv2',
        limit: '1',
        countrycodes: 'vn',
        'accept-language': 'vi'
      }).toString();
      return fetch(geocodeUrl, { signal: searchController.signal })
        .then(response => {
          if (!response.ok) throw new Error('Không thể xác định khu vực tìm điểm du lịch.');
          return response.json();
        })
        .then(places => {
          if (!Array.isArray(places) || places.length === 0) {
            throw new Error(`Không tìm thấy khu vực “${location}” ở Việt Nam.`);
          }
          const place = places[0];
          const osmId = Number(place.osm_id);
          if (!Number.isSafeInteger(osmId) || osmId <= 0) {
            throw new Error('Khu vực này chưa có mã bản đồ để tìm địa điểm du lịch.');
          }
          if (place.osm_type === 'relation') {
            return {
              areaName: place.name || location,
              query: `[out:json][timeout:25];area(${3600000000 + osmId})->.searchArea;(nwr["tourism"](area.searchArea););out tags center ${maxTourismResults + 1};`
            };
          }
          if (place.osm_type === 'way') {
            return {
              areaName: place.name || location,
              query: `[out:json][timeout:25];area(${2400000000 + osmId})->.searchArea;(nwr["tourism"](area.searchArea););out tags center ${maxTourismResults + 1};`
            };
          }
          const latitude = Number(place.lat);
          const longitude = Number(place.lon);
          if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) {
            throw new Error('Không xác định được tọa độ khu vực tìm kiếm.');
          }
          return {
            areaName: place.name || location,
            query: `[out:json][timeout:25];(nwr["tourism"](around:10000,${latitude},${longitude}););out tags center ${maxTourismResults + 1};`
          };
        });
    }
    async function searchTourism(location) {
      const areaSearch = makeTourismOverpassQuery(location);
      const area = typeof areaSearch === 'string'
        ? { areaName: 'khu vực bản đồ hiện tại', query: areaSearch }
        : await areaSearch;
      const overpassUrl = new URL('https://overpass-api.de/api/interpreter');
      overpassUrl.searchParams.set('data', area.query);
      const response = await fetch(overpassUrl, { signal: searchController.signal });
      if (!response.ok) {
        throw new Error(`Dịch vụ dữ liệu du lịch trả về HTTP ${response.status}.`);
      }
      const data = await response.json();
      if (!Array.isArray(data.elements)) {
        throw new Error('Dữ liệu địa điểm du lịch không hợp lệ.');
      }
      const landMask = await getVietnamLandMask();
      const landFeature = turf.feature(landMask);
      const places = data.elements
        .map(element => {
          const latitude = Number(element.lat ?? element.center?.lat);
          const longitude = Number(element.lon ?? element.center?.lon);
          if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return null;
          if (!turf.booleanPointInPolygon(turf.point([longitude, latitude]), landFeature)) return null;
          return { element, latitude, longitude, tags: element.tags || {} };
        })
        .filter(Boolean)
        .sort((first, second) =>
          (first.tags.name || first.tags['name:vi'] || '').localeCompare(
            second.tags.name || second.tags['name:vi'] || '',
            'vi'
          )
        );
      tourismLayer.clearLayers();
      if (map.hasLayer(tourismLayer)) map.removeLayer(tourismLayer);
      if (searchMarker) map.removeLayer(searchMarker);
      if (searchBoundary) map.removeLayer(searchBoundary);
      searchMarker = null;
      searchBoundary = null;
      searchBoundaryGeometry = null;
      resultsBox.replaceChildren();
      if (places.length === 0) {
        resultMessage(`Không tìm thấy điểm du lịch trên đất liền ở ${area.areaName}.`);
        return;
      }
      const header = document.createElement('p');
      header.className = 'search-info';
      const hasMore = data.elements.length > maxTourismResults;
      header.textContent = `Tìm thấy ${places.length}${hasMore ? ` (hiển thị tối đa ${maxTourismResults})` : ''} điểm du lịch ở ${area.areaName}.`;
      resultsBox.append(header);
      places.slice(0, maxTourismResults).forEach(({ element, latitude, longitude, tags }, index) => {
        const name = tags.name || tags['name:vi'] || tags.brand || `Điểm du lịch ${index + 1}`;
        const kind = tags.tourism
          ? tags.tourism.replace(/_/g, ' ')
          : 'địa điểm du lịch';
        const result = {
          name,
          display_name: `${name}, ${area.areaName}, Việt Nam`,
          class: 'tourism',
          type: tags.tourism || 'tourism',
          addresstype: kind,
          osm_type: element.type,
          osm_id: element.id,
          address: { city: area.areaName, country: 'Việt Nam' }
        };
        const marker = L.marker([latitude, longitude], { icon: pinIcon('selected') })
          .bindPopup(searchPopupContent(result, latitude, longitude));
        tourismLayer.addLayer(marker);
        const button = document.createElement('button');
        const nameElement = document.createElement('strong');
        const kindElement = document.createElement('small');
        button.className = 'search-result';
        button.type = 'button';
        nameElement.textContent = name;
        kindElement.textContent = kind;
        button.append(nameElement, document.createElement('br'), kindElement);
        button.addEventListener('click', () => {
          map.flyTo([latitude, longitude], 16, { duration: 1.2 });
          marker.openPopup();
        });
        resultsBox.append(button);
      });
      const credit = document.createElement('div');
      credit.className = 'search-credit';
      credit.innerHTML = 'Dữ liệu địa điểm từ <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> / Overpass API';
      resultsBox.append(credit);
      tourismLayer.addTo(map);
      const bounds = tourismLayer.getBounds();
      if (bounds.isValid()) map.flyToBounds(bounds, { padding: [55, 55], maxZoom: 15, duration: 1.2 });
      resultsBox.classList.add('open');
    }
    searchForm.addEventListener('submit', async event => {
      event.preventDefault();
      const query = searchInput.value.trim();
      if (!query) { searchInput.focus(); return; }
      searchSelectionId++;
      try {
        const coordinates = parseWgs84Coordinates(query);
        if (coordinates) {
          tourismLayer.clearLayers();
          if (map.hasLayer(tourismLayer)) map.removeLayer(tourismLayer);
          if (searchMarker) map.removeLayer(searchMarker);
          if (searchBoundary) map.removeLayer(searchBoundary);
          searchBoundary = null;
          searchBoundaryGeometry = null;
          const { latitude, longitude } = coordinates;
          const location = L.latLng(latitude, longitude);
          const coordinateMarker = L.marker(location, { icon: pinIcon('selected') })
            .addTo(map)
            .bindPopup(popupContent(
              'Vị trí theo tọa độ WGS84',
              `${latitude.toFixed(6)}, ${longitude.toFixed(6)}`
            ));
          searchMarker = coordinateMarker;
          const zoom = Math.max(map.getZoom(), 15);
          if (map.getCenter().equals(location) && map.getZoom() === zoom) {
            coordinateMarker.openPopup();
          } else {
            map.once('moveend', () => coordinateMarker.openPopup());
            map.flyTo(location, zoom, { duration: 1.2 });
          }
          searchInput.value = `${latitude}, ${longitude}`;
          resultsBox.classList.remove('open');
          showToast('Đã ghim vị trí theo tọa độ WGS84.');
          return;
        }
      } catch (error) {
        showToast(error.message);
        return;
      }
      // Nominatim chỉ được gọi khi người dùng gửi tìm kiếm, không tự động gợi ý.
      if (Date.now() - lastSearchAt < 1100) { showToast('Vui lòng đợi một giây trước khi tìm tiếp.'); return; }
      lastSearchAt = Date.now();
      tourismLayer.clearLayers();
      if (map.hasLayer(tourismLayer)) map.removeLayer(tourismLayer);
      if (searchController) searchController.abort();
      searchController = new AbortController();
      resultMessage('Đang tìm địa điểm...');
      try {
        const tourismSearch = parseTourismSearch(query);
        if (tourismSearch) {
          await searchTourism(tourismSearch.location);
          return;
        }
        const url = new URL('https://nominatim.openstreetmap.org/search');
        url.search = new URLSearchParams({ q: query, format: 'jsonv2', limit: '10', polygon_geojson: '1', countrycodes: 'vn', 'accept-language': 'vi' }).toString();
        const response = await fetch(url, { signal: searchController.signal });
        if (!response.ok) throw new Error('Search unavailable');
        const results = await response.json();
        resultsBox.replaceChildren();
        if (!results.length) { resultMessage('Không tìm thấy địa điểm. Hãy thử một từ khóa khác.'); return; }
        results.forEach(result => {
          const button = document.createElement('button');
          button.className = 'search-result'; button.type = 'button';
          button.textContent = result.display_name;
          button.addEventListener('click', async () => {
            const lat = Number(result.lat), lng = Number(result.lon);
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;
            const selectionId = ++searchSelectionId;
            tourismLayer.clearLayers();
            if (map.hasLayer(tourismLayer)) map.removeLayer(tourismLayer);
            if (searchMarker) map.removeLayer(searchMarker);
            if (searchBoundary) map.removeLayer(searchBoundary);
            searchBoundary = null;
            searchBoundaryGeometry = null;
            searchMarker = L.marker([lat, lng], { icon: pinIcon('selected') })
              .addTo(map)
              .bindPopup(searchPopupContent(result, lat, lng));
            if (isAreaGeometry(result.geojson)) {
              try {
                const landMask = await getVietnamLandMask();
                if (selectionId !== searchSelectionId) return;
                const landArea = turf.intersect(turf.featureCollection([
                  turf.feature(result.geojson),
                  turf.feature(landMask)
                ]));
                if (landArea) {
                  searchBoundaryGeometry = landArea.geometry;
                  searchBoundary = L.geoJSON(landArea, {
                    style: {
                      color: '#1677ff',
                      weight: 3,
                      opacity: 0.95,
                      fill: false
                    }
                  }).addTo(map);
                  const bounds = searchBoundary.getBounds();
                  if (bounds.isValid()) {
                    map.flyToBounds(bounds, { padding: [50, 50], maxZoom: 15, duration: 1.2 });
                  } else {
                    map.flyTo([lat, lng], 14, { duration: 1.2 });
                    showToast('Không thể hiển thị ranh giới địa điểm này.');
                  }
                } else {
                  map.flyTo([lat, lng], 14, { duration: 1.2 });
                  showToast('Không tìm thấy phần ranh giới trên đất liền Việt Nam.');
                }
              } catch (error) {
                vietnamLandMaskPromise = null;
                console.error('Không thể cắt ranh giới theo phần đất liền Việt Nam:', error);
                map.flyTo([lat, lng], 14, { duration: 1.2 });
                showToast('Không thể tải hoặc xử lý dữ liệu đất liền. Vui lòng thử lại.');
              }
            } else {
              map.flyTo([lat, lng], 14, { duration: 1.2 });
              showToast('Địa điểm này chưa có dữ liệu ranh giới; đã đánh dấu vị trí.');
            }
            if (selectionId !== searchSelectionId) return;
            setTimeout(() => {
              if (selectionId === searchSelectionId) searchMarker.openPopup();
            }, 1100);
            searchInput.value = result.display_name.split(',')[0];
            resultsBox.classList.remove('open');
          });
          resultsBox.append(button);
        });
        const credit = document.createElement('div');
        credit.className = 'search-credit';
        credit.innerHTML = 'Kết quả từ <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> / Nominatim';
        resultsBox.append(credit); resultsBox.classList.add('open');
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error('Không thể tìm kiếm địa điểm:', error);
          resultMessage(error.message || 'Không thể tìm kiếm lúc này. Vui lòng thử lại sau.');
        }
      }
    });
    searchInput.addEventListener('input', () => resultsBox.classList.remove('open'));
    document.addEventListener('click', event => { if (!event.target.closest('.search-area')) resultsBox.classList.remove('open'); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') resultsBox.classList.remove('open'); });

    async function hienThiHoKhoan() {
      const response = await fetch('/ho-khoan/api');
      if (!response.ok) {
        throw new Error(`API hố khoan trả về HTTP ${response.status}`);
      }

      const data = await response.json();
      if (!Array.isArray(data)) {
        throw new Error('Dữ liệu hố khoan không hợp lệ.');
      }

      const markers = [];
      data.forEach(hole => {
        if (
          !hole || hole.latitude == null || hole.longitude == null ||
          hole.latitude === '' || hole.longitude === ''
        ) {
          return;
        }

        const latitude = Number(hole.latitude);
        const longitude = Number(hole.longitude);
        if (
          !Number.isFinite(latitude) || !Number.isFinite(longitude) ||
          latitude < -90 || latitude > 90 ||
          longitude < -180 || longitude > 180
        ) {
          return;
        }

        const marker = L.marker([latitude, longitude], {
          icon: window.createBoreholeIcon()
        });
        const popup = document.createElement('div');
        const title = document.createElement('strong');
        const project = document.createElement('div');
        title.textContent = hole.ma_ho_khoan || `Hố khoan ${hole.id}`;
        project.textContent = `Mã công trình: ${hole.cong_trinh_id}`;
        popup.append(title, document.createElement('br'), project);
        marker.bindPopup(popup);
        markers.push(marker);
      });

      hoKhoanMarkers.forEach(marker => map.removeLayer(marker));
      hoKhoanMarkers = markers;
      hoKhoanMarkers.forEach(marker => marker.addTo(map));

      if (hoKhoanMarkers.length > 0) {
        map.fitBounds(L.featureGroup(hoKhoanMarkers).getBounds(), {
          padding: [50, 50]
        });
      }
    }
  </script>


