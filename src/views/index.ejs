    async function focusAssignedArea() {
      if (document.body.dataset.userRole !== 'ky-su') return;
      try {
        if (document.body.dataset.hasAssignedArea !== 'true') return;
        const response = await fetch('/nguoi-dung/khu-vuc-phan-cong');
        if (!response.ok) {
          const result = await response.json().catch(() => null);
          throw new Error(
            result?.message || `Không tải được khu vực được giao (HTTP ${response.status}).`
          );
        }
        const result = await response.json();
        const bounds = result.bounds;
        if (!bounds) {
          throw new Error('Máy chủ không trả về ranh giới khu vực được giao.');
        }
        const coordinates = [bounds.south, bounds.north, bounds.west, bounds.east];
        if (!coordinates.every(Number.isFinite)) {
          throw new Error('Ranh giới khu vực được giao không hợp lệ.');
        }
        const assignedBounds = [
          [bounds.south, bounds.west],
          [bounds.north, bounds.east]
        ];
        if (assignedAreaLayer) map.removeLayer(assignedAreaLayer);
        const boundaryStyle = {
          color: '#d62828',
          weight: 3,
          opacity: 0.95,
          fillColor: '#ef4444',
          fillOpacity: 0.06
        };
        assignedAreaLayer = bounds.geometry
          ? L.geoJSON({
              type: 'Feature',
              properties: { name: result.area },
              geometry: bounds.geometry
            }, { style: boundaryStyle }).addTo(map)
          : L.rectangle(assignedBounds, boundaryStyle).addTo(map);
        const displayBounds = assignedAreaLayer.getBounds();
        if (!displayBounds.isValid()) {
          throw new Error('Ranh giới khu vực được phân công không hợp lệ.');
        }
        if (assignedAreaPin) map.removeLayer(assignedAreaPin);
        if (
          Number.isFinite(result.center?.latitude) &&
          Number.isFinite(result.center?.longitude)
        ) {
          const pinPopup = document.createElement('div');
          const pinTitle = document.createElement('strong');
          const pinDescription = document.createElement('div');
          pinTitle.textContent = result.area;
          pinDescription.textContent = result.center.isPinned
            ? 'Vị trí đã ghim khi phân công'
            : 'Tâm khu vực; chưa lưu tọa độ ghim riêng';
          pinPopup.append(pinTitle, pinDescription);
          assignedAreaPin = L.marker([
            result.center.latitude,
            result.center.longitude
          ]).addTo(map).bindPopup(pinPopup);
        }
        map.fitBounds(displayBounds, { maxZoom: 16, padding: [35, 35] });
        await showAssignedMapLayers(displayBounds);
      } catch (error) {
        console.error('Không thể tải khu vực được giao:', error);
        showToast(error.message || 'Không thể hiển thị dữ liệu khu vực được giao.');
      }
    }
