<script>
  void focusAssignedArea();

  (() => {
    const currentRole = document.body.dataset.userRole;
    const enabledPermissions = new Set(
      JSON.parse(document.body.dataset.enabledPermissions || '[]')
    );
    const roleLabels = {
      'ky-su': 'Kỹ sư',
      'quan-tri-vien': 'Quản trị viên',
      'nguoi-xem-ban-do': 'Người xem bản đồ'
    };

    function guardAction(event) {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const action = target.closest('[data-required-roles]');
      if (!action) return;

      const requiredRoles = action.dataset.requiredRoles.split(',');
      if (currentRole && requiredRoles.includes(currentRole)) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      const role = requiredRoles[0];
      const roleName = roleLabels[role] || 'đúng chức vụ';
      const actionName =
        action.getAttribute('aria-label') ||
        action.getAttribute('title') ||
        action.textContent.trim() ||
        'chức năng này';

      if (window.confirm(
        `Muốn dùng "${actionName}", bạn cần đăng nhập với vai trò ${roleName}. Đăng nhập ngay?`
      )) {
        window.location.href = `/dang-nhap/${role}`;
      }
    }

    document.querySelectorAll('[data-system-permission]').forEach((action) => {
      if (!enabledPermissions.has(action.dataset.systemPermission)) {
        action.hidden = true;
      }
    });

    document.addEventListener('click', guardAction, true);
    document.addEventListener('submit', guardAction, true);
  })();
</script>
