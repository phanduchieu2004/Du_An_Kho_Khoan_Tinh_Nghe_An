<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    main { max-width: 1440px; margin: 0 auto; padding: 28px 24px 48px; }
    .request-card { margin-bottom: 18px; padding: 20px; border: 1px solid #dce5e1; border-radius: 10px; background: white; }
    .request-card h2 { font-size: 18px; }
    .payloads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .payload { min-width: 0; }
    .payload pre { max-height: 340px; overflow: auto; padding: 12px; border: 1px solid #e1e9e5; border-radius: 7px; background: #f8faf9; white-space: pre-wrap; overflow-wrap: anywhere; }
    @media (max-width: 700px) { main { padding: 22px 12px 36px; } .payloads { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <%- include('thanh-phan/dau_trang_quan_tri') %>
  <main>
    <h1 class="h3 mb-3"><%= title %></h1>
    <% if (requests.length === 0) { %>
      <div class="alert alert-light border">Không có yêu cầu sửa công trình nào đang chờ duyệt.</div>
    <% } else { %>
      <% requests.forEach((request) => { %>
        <article class="request-card">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
              <h2 class="mb-1"><%= request.ten_cong_trinh || `Công trình ${request.cong_trinh_id}` %></h2>
              <div class="text-secondary small">Mã <%= request.cong_trinh_id %> · Người yêu cầu: <%= request.nguoi_yeu_cau %> · <%= new Date(request.ngay_tao).toLocaleString('vi-VN') %></div>
            </div>
            <form method="post" action="/cong-trinh/sua-cho-duyet/<%= request.id %>/duyet" onsubmit="return confirm('Duyệt các thay đổi này? Sau khi duyệt, dữ liệu công trình sẽ được cập nhật.');">
              <button class="btn btn-success" type="submit">Duyệt sửa công trình</button>
            </form>
          </div>
          <div class="payloads">
            <div class="payload">
              <h3 class="h6">Dữ liệu hiện tại</h3>
              <pre><%= JSON.stringify(request.du_lieu_cu, null, 2) %></pre>
            </div>
            <div class="payload">
              <h3 class="h6">Dữ liệu đề xuất</h3>
              <pre><%= JSON.stringify(request.du_lieu_de_xuat, null, 2) %></pre>
            </div>
          </div>
        </article>
      <% }) %>
    <% } %>
  </main>
</body>
</html>
