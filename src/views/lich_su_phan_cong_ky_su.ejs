<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <style>
    body { margin: 0; background: #f3f6f4; color: #1f302d; font-family: "Segoe UI", sans-serif; }
    main { max-width: 1440px; margin: 0 auto; padding: 28px 24px 48px; }
    .table-frame { overflow: auto; border: 1px solid #dce5e1; background: #fff; }
    table { margin: 0 !important; white-space: nowrap; }
    thead th { background: #e9f0ed !important; color: #344b44; }
    td { vertical-align: middle; }
    .empty { padding: 32px !important; text-align: center; color: #667772; }
    @media (max-width: 700px) { main { padding: 22px 12px 36px; } }
  </style>
</head>
<body>
  <%- include('thanh-phan/dau_trang_cong') %>
  <main>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
      <div>
        <h1 class="h3 mb-1"><%= title %></h1>
        <p class="text-secondary mb-0">Theo dõi nhiệm vụ được phân công; gửi yêu cầu gia hạn khi thời hạn đã quá.</p>
      </div>
      <a class="btn btn-outline-danger" href="/cong-trinh/yeu-cau-huy">Gửi đơn hủy phân công</a>
    </div>
    <% if (renewalSubmitted) { %>
      <div class="alert alert-success" role="status">Đã gửi yêu cầu gia hạn. Thời hạn chỉ được cập nhật sau khi Quản trị viên duyệt.</div>
    <% } %>
    <ul class="nav nav-tabs mb-3" id="assignment-history-tabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed-panel" type="button" role="tab" aria-controls="completed-panel" aria-selected="true">Công trình hoàn thiện (<%= completed.length %>)</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="in-progress-tab" data-bs-toggle="tab" data-bs-target="#in-progress-panel" type="button" role="tab" aria-controls="in-progress-panel" aria-selected="false">Đang thực hiện (<%= inProgress.length %>)</button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="unfinished-tab" data-bs-toggle="tab" data-bs-target="#unfinished-panel" type="button" role="tab" aria-controls="unfinished-panel" aria-selected="false">Không thực hiện / chưa hoàn thành (<%= unfinished.length %>)</button>
      </li>
    </ul>
    <div class="tab-content">
      <% const tabs = [
        { id: 'completed-panel', rows: completed },
        { id: 'in-progress-panel', rows: inProgress },
        { id: 'unfinished-panel', rows: unfinished },
      ]; %>
      <% tabs.forEach((tab) => { %>
        <section class="tab-pane fade <%= tab.id === 'completed-panel' ? 'show active' : '' %>" id="<%= tab.id %>" role="tabpanel">
          <div class="table-frame">
            <table class="table table-hover table-striped table-bordered align-middle">
              <thead><tr><th>Mã công trình</th><th>Tên công trình</th><th>Khu vực</th><th>Bắt đầu</th><th>Hạn hoàn thành</th><th>Trạng thái</th><th>Đơn hủy</th><th>Chức năng</th></tr></thead>
              <tbody>
                <% if (tab.rows.length === 0) { %>
                  <tr><td class="empty" colspan="8">Chưa có công trình trong nhóm này.</td></tr>
                <% } else { %>
                  <% tab.rows.forEach((assignment) => { %>
                    <tr>
                      <td><%= assignment.cong_trinh_id %></td>
                      <td><%= assignment.ten_cong_trinh || `Công trình ${assignment.cong_trinh_id}` %></td>
                      <td><%= assignment.khu_vuc || '—' %></td>
                      <td><%= assignment.tu_ngay ? new Date(assignment.tu_ngay).toLocaleDateString('vi-VN') : 'Không giới hạn' %></td>
                      <td><%= assignment.den_ngay ? new Date(assignment.den_ngay).toLocaleDateString('vi-VN') : 'Không giới hạn' %></td>
                      <td>
                        <% if (assignment.history_status === 'completed') { %>
                          <span class="badge text-bg-success">Hoàn thành</span>
                        <% } else if (assignment.dang_hieu_luc) { %>
                          <span class="badge text-bg-primary">Đang thực hiện</span>
                        <% } else { %>
                          <span class="badge text-bg-secondary">Đã kết thúc, chưa hoàn thành</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (assignment.cancellation_status === 'cho_duyet') { %>
                          <span class="badge text-bg-warning">Chờ duyệt</span>
                        <% } else if (assignment.cancellation_status === 'da_duyet') { %>
                          <span class="badge text-bg-secondary">Đã duyệt</span>
                        <% } else { %>—<% } %>
                      </td>
                      <td>
                        <% if (assignment.dang_hieu_luc && !assignment.da_hoan_thanh && assignment.den_ngay) { %>
                          <% if (assignment.renewal_status === 'cho_duyet') { %>
                            <span class="badge text-bg-warning">Gia hạn chờ duyệt</span>
                          <% } else { %>
                            <button class="btn btn-sm btn-outline-primary request-renewal"
                              type="button"
                              data-assignment-id="<%= assignment.assignment_id %>"
                              data-project-name="<%= assignment.ten_cong_trinh || `Công trình ${assignment.cong_trinh_id}` %>"
                              data-current-end-date="<%= new Date(assignment.den_ngay).toISOString().slice(0, 10) %>">Gia hạn</button>
                          <% } %>
                        <% } else { %>—<% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </section>
      <% }); %>
    </div>
    <dialog id="renewalDialog" class="p-0 border-0 rounded-3 shadow" aria-labelledby="renewalTitle" style="width:min(560px, calc(100% - 24px));">
      <div class="p-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
          <div>
            <h2 class="h5 mb-1" id="renewalTitle">Yêu cầu gia hạn phân công</h2>
            <p class="text-secondary mb-0" id="renewalProjectName"></p>
          </div>
          <button class="btn-close" type="button" id="closeRenewalDialog" aria-label="Đóng"></button>
        </div>
        <form method="post" action="/cong-trinh/yeu-cau-gia-han">
          <input type="hidden" name="assignmentId" id="renewalAssignmentId">
          <div class="mb-3">
            <label class="form-label" for="renewalEndDate">Ngày kết thúc mới</label>
            <input class="form-control" type="date" name="newEndDate" id="renewalEndDate" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="renewalReason">Lý do gia hạn</label>
            <textarea class="form-control" name="reason" id="renewalReason" rows="3" minlength="5" maxlength="2000" required></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" type="button" id="cancelRenewal">Hủy</button>
            <button class="btn btn-primary" type="submit">Gửi yêu cầu</button>
          </div>
        </form>
      </div>
    </dialog>
  </main>
  <script>
    const renewalDialog = document.getElementById('renewalDialog');
    const todayParts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Ho_Chi_Minh',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    }).formatToParts(new Date());
    const todayValue = ['year', 'month', 'day']
      .map((type) => todayParts.find((part) => part.type === type)?.value)
      .join('-');
    const renewalEndDate = document.getElementById('renewalEndDate');
    document.querySelectorAll('.request-renewal').forEach((button) => {
      const currentEndDate = new Date(`${button.dataset.currentEndDate}T00:00:00Z`);
      currentEndDate.setUTCDate(currentEndDate.getUTCDate() + 1);
      const nextAllowedEndDate = currentEndDate.toISOString().slice(0, 10);
      button.addEventListener('click', () => {
        renewalEndDate.min = nextAllowedEndDate > todayValue ? nextAllowedEndDate : todayValue;
        document.getElementById('renewalAssignmentId').value = button.dataset.assignmentId;
        document.getElementById('renewalProjectName').textContent = button.dataset.projectName;
        renewalEndDate.value = '';
        renewalDialog.showModal();
      });
    });
    document.getElementById('closeRenewalDialog').addEventListener('click', () => renewalDialog.close());
    document.getElementById('cancelRenewal').addEventListener('click', () => renewalDialog.close());
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
